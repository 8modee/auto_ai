# ═══════════════════════════════════════════════════════════════
# THE INSTITUTION — SIMPLE API KEYS
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env (the system will load it automatically)
# cp .env.simple .env

# Edit this file to add API keys when you feel like it.
# The system works with ZERO keys - these just make it better.

# ─── AI PROVIDERS (optional) ──────────────────────────────────
# Priority: offline > ollama > groq > gemini
# Add ONE at a time, test, then add more

# Groq (fast, free tier)
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (free tier)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Mistral (free tier)
# Get key from: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# ─── LOCAL MODELS (optional) ───────────────────────────────────
# Ollama runs on your machine (free, no API key needed)
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Then: ollama pull llama3.1:8b
OLLAMA_ENABLED=true

# ─── DASHBOARD LOGIN ──────────────────────────────────────────
# Change these to anything you want
DASHBOARD_USER=founder
DASHBOARD_PASS=changeme

# ─── SECRET KEY ───────────────────────────────────────────────
# Generate a random string (or use this one, but change it)
SECRET_KEY=change-this-to-a-random-string-12345

# ─── OTHER SETTINGS ───────────────────────────────────────────
# You can change these if needed, but defaults are fine
INSTITUTION_ROOT=/opt/institution
DASHBOARD_PORT=8080
LOG_LEVEL=INFO
